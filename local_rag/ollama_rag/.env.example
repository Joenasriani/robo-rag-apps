# Copy this file to .env and fill in your values.
# Never commit a real .env to version control.

# Ollama server (start with: ollama serve)
OLLAMA_BASE_URL=http://localhost:11434

# Pull these models before running: ollama pull nomic-embed-text && ollama pull llama3
OLLAMA_EMBED_MODEL=nomic-embed-text
OLLAMA_LLM_MODEL=llama3

# Optional tuning
CHUNK_SIZE=800
CHUNK_OVERLAP=150
RETRIEVAL_K=4
